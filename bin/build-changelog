#!/usr/bin/env python3
"""Render site/changelog/index.html from plain-sentence entries (Vikunja #4953). Writes one file; never deploys.

Usage:  bin/build-changelog [--src REPO_ROOT] [--check]
Reads:  site/changelog/entries.txt  (lines "YYYY-MM-DD | sentence", newest first; "#" lines are comments)
Writes: site/changelog/index.html   (with --check: writes nothing, exits 1 if the committed page is stale)
Why not raw git-cliff output? CHANGELOG.md (git cliff -o CHANGELOG.md, config cliff.toml) is the developer log:
        "Bug fixes", scopes, hashes. Customers get this page, written as sentences. Running
        git cliff --unreleased shows which commits are new since the last entry, as a prompt for what to write.
Rules:  dates must be valid and not increase down the page; the page shows "Last updated" = newest date; every sentence
        is HTML-escaped. Stdlib only.
"""
import argparse, datetime, html, pathlib, sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
MAIL = "support@spellaloud.invalid"      # same placeholder as the other pages until Marc chooses a mailbox

PAGE = """<!doctype html>
<!-- DRAFT changelog page (Vikunja #4953). Generated by bin/build-changelog from entries.txt; edit that, not this file.
     NOT PUBLISHED. All copy is proposed, Marc to confirm. First-party only: no scripts, fonts or analytics. -->
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>What's new: Spellaloud</title>
<style>
  :root {{ --bg:#fffaf0; --fg:#1d2430; --muted:#566070; --accent:#1f6f5c }}
  @media (prefers-color-scheme: dark) {{ :root {{ --bg:#14181f; --fg:#eef1f5; --muted:#a3adbb; --accent:#6fd1b5 }} }}
  body {{ margin:0; background:var(--bg); color:var(--fg); font:18px/1.6 system-ui,-apple-system,"Segoe UI",sans-serif }}
  main {{ max-width:40rem; margin:0 auto; padding:2rem 1rem 3rem }} a {{ color:var(--accent) }}
  a:focus-visible {{ outline:3px solid var(--accent); outline-offset:2px }}
  ul.log {{ list-style:none; padding:0 }} ul.log li {{ margin:1.2rem 0 }} time {{ display:block; color:var(--muted); font-size:.9rem }}
  footer {{ margin-top:2rem; color:var(--muted); font-size:.9rem }}
</style>
</head>
<body>
<main>
  <h1>What's new</h1>
  <p><em>Draft, proposed, Marc to confirm.</em> Last updated {last}.</p>
  <ul class="log">
{items}
  </ul>
  <footer><nav class="trust" aria-label="About this site"><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a> · <a href="/help/">Help</a> · <a href="mailto:{mail}">{mail}</a></nav></footer>
</main>
</body>
</html>
"""


def parse(text):
    """Return [(date, sentence)] from entries.txt, validating dates and order."""
    out, prev = [], None
    for n, line in enumerate(text.splitlines(), 1):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        date, sep, sentence = (p.strip() for p in line.partition("|"))
        if not sep or not sentence:
            sys.exit(f"build-changelog: line {n}: want 'YYYY-MM-DD | sentence'")
        try:
            d = datetime.date.fromisoformat(date)
        except ValueError:
            sys.exit(f"build-changelog: line {n}: bad date {date!r}")
        if prev and d > prev:
            sys.exit(f"build-changelog: line {n}: entries must be newest first")
        prev = d
        out.append((date, sentence))
    if not out:
        sys.exit("build-changelog: no entries")
    return out


def render(entries):
    items = "\n".join(f'    <li><time datetime="{d}">{d}</time>{html.escape(s, quote=False)}</li>' for d, s in entries)
    return PAGE.format(last=entries[0][0], items=items, mail=MAIL)


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--src", default=str(ROOT))
    ap.add_argument("--check", action="store_true", help="fail if site/changelog/index.html is stale; write nothing")
    a = ap.parse_args()
    d = pathlib.Path(a.src).resolve() / "site" / "changelog"
    try:
        page = render(parse((d / "entries.txt").read_text(encoding="utf-8")))
    except FileNotFoundError as e:
        sys.exit(f"build-changelog: missing input: {e}")
    target = d / "index.html"
    if a.check:
        if not target.is_file() or target.read_text(encoding="utf-8") != page:
            sys.exit("build-changelog: site/changelog/index.html is stale; run bin/build-changelog")
        print("build-changelog: up to date")
        return
    target.write_text(page, encoding="utf-8")
    print(f"build-changelog: wrote {target} ({len(page)} bytes)")


if __name__ == "__main__":
    main()
